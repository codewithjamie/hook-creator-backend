# ─────────────────────────────────────────
#  OpenEdge NestJS — Environment Variables
# ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI / Whisper
OPENAI_API_KEY=sk-...

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=openedge-clips

# Upload limits
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=/tmp/openedge-uploads

# FFmpeg
# Leave blank to auto-detect via ffmpeg-static
FFMPEG_PATH=
FFPROBE_PATH=

# Whisper chunking
WHISPER_CHUNK_DURATION_SECONDS=600

# Hook selection
MAX_HOOKS_RETURNED=6
DEFAULT_HOOK_MIN_DURATION=6
DEFAULT_HOOK_MAX_DURATION=12

# Logging
LOG_LEVEL=info
